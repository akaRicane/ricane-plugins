# ── CMake build trees ─────────────────────────────────────────
# Each plugin builds into bank/<plugin>/build/ ; ignore all of them.
build/
build-*/
cmake-build-*/

# Shared CPM download cache, used by pluginval's dependencies (-DENABLE_PLUGINVAL=ON).
.cpm-cache/

# ── Compiled artifacts (belt-and-suspenders; normally under build/) ──
*.o
*.obj
*.a
*.lib
*.exe

# ── Built plugin bundles ──────────────────────────────────────
*.vst3
*.component
*.app

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
._*

# ── Editors / IDEs ────────────────────────────────────────────
.obsidian
.vscode/
.idea/
*.xcodeproj/
*.swp
*~

# ── Claude Code (keep project settings, ignore local overrides) ──
.claude/settings.local.json

# ── JUCE framework ────────────────────────────────────────────
# JUCE/ is a git submodule pinned to the 8.0.13 tag (see .gitmodules).
# Its contents are tracked by that submodule, not by this repo, so nothing
# to ignore here. Fetch it with:  git submodule update --init
